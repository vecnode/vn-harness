%%{init: {"theme":"base","themeVariables":{"fontFamily":"ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, sans-serif","fontSize":"13px","lineColor":"#94a3b8"},"flowchart":{"nodeSpacing":26,"rankSpacing":34,"curve":"linear","htmlLabels":true,"useMaxWidth":false}}}%%
flowchart TD
    subgraph Enc["encoders"]
        direction LR
        EX["context encoder<br/>trainable"]
        EY["target encoder<br/>EMA copy"]
    end
    X["context patches<br/>visible"]
    Y["target patches<br/>masked"]
    SX["context embedding"]
    Z["latent z<br/>optional, carries uncertainty"]
    P["predictor<br/>trainable"]
    SH["predicted embedding"]
    LOSS["prediction loss"]
    REG["anti-collapse<br/>regularizer"]
    SY["target embedding"]
    GOAL["objective: predict<br/>representations, never pixels"]

    X --> EX
    Y --> EY
    EX --> LOSS
    EY --> LOSS
    SX --> P
    Z --> P
    P --> SH
    SH --> LOSS
    REG --> LOSS
    REG -.->|penalises collapse| SY
    LOSS -.->|trains this path| EX
    EX -.->|stop-grad| EY
    LOSS --> GOAL

    classDef train fill:#fef3c7,stroke:#b45309,stroke-width:2px,color:#78350f
    classDef frozen fill:#e0f2fe,stroke:#0369a1,stroke-width:2px,color:#0c4a6e
    classDef state fill:#f1f5f9,stroke:#94a3b8,stroke-width:1px,color:#0f172a
    classDef loss fill:#fee2e2,stroke:#b91c1c,stroke-width:2px,color:#7f1d1d
    classDef obj fill:#dcfce7,stroke:#15803d,stroke-width:2px,color:#14532d

    class EX,P train
    class EY frozen
    class X,Y,SX,SY,Z,SH,REG state
    class LOSS loss
    class GOAL obj
    style Enc fill:#f8fafc,stroke:#cbd5e1,color:#0f172a