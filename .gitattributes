# Line endings the tooling depends on.
#
# A CRLF shebang breaks `./install.sh` on macOS/Linux, so shell scripts are
# pinned to LF no matter which OS checks the repo out.
*.sh text eol=lf

# Batch files are the Windows launchers; CRLF is what cmd.exe expects.
*.bat text eol=crlf

# The forked browser bundles are GENERATED and byte-compared by
# scripts/sync-vendored.ps1 (-Check hashes the working copy). With git's
# autocrlf the Windows checkout would rewrite them to CRLF and report phantom
# drift, so they are pinned to LF too.
packages/*/lib/client.js text eol=lf

# The vendored pdf.js tree is GENERATED and byte-hashed by
# packages/dsh-pdf/vendor/build.mjs --check (every file's sha256 plus a digest
# over each tree, recorded in lib/vendor/VERSION.json), so its TEXT files are
# pinned to LF for exactly the reason the forked bundles above are: a Windows
# checkout would rewrite them to CRLF and report phantom drift - and the two
# LICENSE files live INSIDE the hashed cMap and standard-font trees, so
# converting them would change a tree digest too. The .bcmap and font binaries
# are detected as binary and are never touched.
packages/dsh-pdf/lib/vendor/*.mjs text eol=lf
packages/dsh-pdf/lib/vendor/VERSION.json text eol=lf
packages/dsh-pdf/lib/vendor/LICENSE text eol=lf
packages/dsh-pdf/lib/vendor/cmaps/LICENSE text eol=lf
packages/dsh-pdf/lib/vendor/standard_fonts/LICENSE_* text eol=lf
